# Linkset Management Layer — environment variables
# Copy to .env and adjust values before running locally

# Port to listen on
PORT=8080

# Public base URL of this resolver (no trailing slash)
RESOLVER_ROOT=http://localhost:8080

# Comma-separated GS1 company prefix(es) this resolver is authorised to serve
ALLOWED_PREFIXES=885

# HTTP redirect status for link resolution (307 = temporary, 301 = permanent)
# ADR-002: use 307 to preserve request method
REDIRECT_STATUS=307

# Path to linkset data file (JSON)
DATA_FILE=./data/linksets.json

# Bearer token for Link Ingest API — leave empty to disable the API (ADR-008)
INGEST_TOKEN=

# Set to 1 to write ingested linksets back to DATA_FILE (persist across restarts)
PERSIST=0

# Set to 0 to suppress per-request logs (recommended during latency benchmarking)
LOG_REQUESTS=1
